# Copy to .env and fill in secrets

# Local dev server (Windows: port 8000 is often taken by Cursor — use 8001)
#   .\scripts\run-dev-server.ps1
# Frontend: VITE_API_BASE_URL=http://127.0.0.1:8001/api  (GodFather_frontend/.env.development)
# Optional: skip ES/Celery index rebuild on startup
# DJANGO_SKIP_KNOWLEDGE_AUTO=1

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Postgres — must match docker-compose (pgvector/pgvector:pg16)
# Local Django runserver: POSTGRES_HOST=localhost
# Django inside Docker: POSTGRES_HOST=postgres (set in docker-compose environment)
POSTGRES_DB=godfather
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
PGVECTOR_ENABLED=true

REDIS_CACHE_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
ELASTICSEARCH_HOSTS=http://localhost:9200

# RAG production tuning (Phase 15)
RAG_CROSS_ENCODER_ENABLED=true
RAG_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_WEIGHTED_HYBRID_ENABLED=true
